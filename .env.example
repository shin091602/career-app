# ---------------------------------------------------------------
# サーバー側（Vercel Functions）でのみ読む値。
# VITE_ を付けるとフロントに埋め込まれてしまうので、絶対に付けないこと。
# ローカルでは .env.local にコピーして使う（.env.local は git 管理外）。
# ---------------------------------------------------------------

# AIフィードバックを使うための簡易パスコード。
# アプリのホーム画面で同じ値を入力する。未設定だとAPIは 503 を返す。
APP_PASSCODE=change-me

# 使用するAIプロバイダ: gemini | claude
AI_PROVIDER=gemini

# 出力トークンの上限（未設定なら 1024、上限 4096）
AI_MAX_OUTPUT_TOKENS=1024

# --- Gemini を使う場合 ---
GEMINI_API_KEY=
# 未設定なら gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------
# 素材の自動生成（npm run media）で使う値。
# 画像・動画の生成は有料で、無料枠が無い。上限を必ず設定すること。
# GEMINI_API_KEY は上の値を使い回す。
# ---------------------------------------------------------------

# 1回の実行で使ってよい上限（ドル）。見積もりがこれを超えると実行しない
MEDIA_MAX_COST_USD=5

# --- Claude を使う場合 ---
ANTHROPIC_API_KEY=
# 未設定なら claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
